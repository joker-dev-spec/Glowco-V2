# ------------------------------------------------------------------
# Glowco-V2 environment variables
# Copy this file to a real `.env` on your server or set these in
# Railway / Render dashboard.
# ------------------------------------------------------------------

# Public URL of your site (no trailing slash). Used to build links.
APP_URL=https://your-app.up.railway.app

# MySQL / MariaDB connection (Railway MySQL or Render external DB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=glowco_db
DB_USER=root
DB_PASS=
